APP_NAME=CityQuest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cityquest
DB_USERNAME=cityquest
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
# Comma-separated trusted proxy IPs/CIDRs. Empty means no forwarded headers trusted.
TRUSTED_PROXIES=
SEED_DATABASE=false
